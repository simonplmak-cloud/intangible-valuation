# Required environment variables for the Intangible Valuation WebApp.
# Set these in Vercel (Project → Settings → Environment Variables) or .env.local.

# Auth (next-auth) — REQUIRED in production
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# SurrealDB 3.x — REQUIRED for persistence (credentials in ~/.env.opencode)
SURREALDB_URL=
SURREALDB_NS=intangible_valuation
SURREALDB_DB=production
SURREALDB_USER=root
SURREALDB_PASS=

# Stripe billing — optional (checkout degrades gracefully to 503 without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OAuth providers — optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# Site URL (used by sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=https://intangible-valuation.vercel.app
